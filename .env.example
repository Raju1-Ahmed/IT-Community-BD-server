# Firebase Admin service account (server-only; never put these in frontend)
FIREBASE_PROJECT_ID=itcommunitybd
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@itcommunitybd.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternatively use one escaped JSON value:
# FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}
# Aliases FIREBASE_ADMIN_* and GOOGLE_APPLICATION_CREDENTIALS_JSON are also supported.
NODE_ENV=production
ENABLE_API_DOCS=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="IT Community BD <no-reply@example.com>"
# Local testing only; never enable this in Render/production.
ALLOW_DEV_OTP_LOG=false
