# Firebase Admin service account (server-only; never put these in frontend)
FIREBASE_PROJECT_ID=itcommunitybd
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@itcommunitybd.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
